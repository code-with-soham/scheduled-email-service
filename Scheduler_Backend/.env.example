NODE_ENV=development
PORT=4000
# Local Docker PostgreSQL from docker-compose.dev.yml. Development-only password.
DATABASE_URL=postgresql://scheduler:scheduler_dev_password@localhost:5432/reachinbox
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails
BULL_BOARD_PATH=/admin/queues
# Google OAuth web client ID. The frontend must send its Google ID token as Bearer <token>.
GOOGLE_CLIENT_ID=
# Required to access the Bull Board route. Use a long, unique value outside local development.
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=change-me-in-production
WORKER_CONCURRENCY=10
MIN_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=200
RATE_LIMIT_WINDOW_SECONDS=3600
# JSON array. Replace every Ethereal placeholder with real credentials before starting the backend.
ETHEREAL_SENDERS=[{"id":"sender-1","name":"ReachInbox Sender 1","email":"YOUR_ETHEREAL_EMAIL","host":"smtp.ethereal.email","port":587,"user":"YOUR_ETHEREAL_USER","pass":"YOUR_ETHEREAL_PASSWORD"}]
# Assign senders to immutable Google subjects after first sign-in. Example tenant ID: google:<Google sub>.
SENDER_TENANT_ASSIGNMENTS=[]
# Slack OAuth app values. Redirect URL must match the Slack app configuration.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/oauth/callback
SLACK_SCOPES=chat:write,channels:read,groups:read
SLACK_STATE_SECRET=change-me-in-production
